# Dependencies
node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Build output
.next/
out/
dist/
build/
*.tsbuildinfo
next-env.d.ts

# Tests
coverage/
playwright-report/
test-results/

# Environment files: never commit real values. Only *.example files are tracked.
.env
.env.*
!.env.example
!.env.*.example

# Secrets and keys
*.pem
*.key
id_*
!id_*.pub

# Local runtime data (dev media uploads, database dumps)
.data/
*.dump
*.sql.gz

# Logs and OS files
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.log
.DS_Store
Thumbs.db

# Platform leftovers
.vercel

# Generated Prisma Client (rebuilt by `prisma generate`)
apps/api/src/generated/
# OpenAPI export is committed on purpose (apps/api/openapi.json)
