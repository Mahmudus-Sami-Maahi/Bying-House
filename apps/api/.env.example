# MetaMax Fashions API — environment variables
# Copy to `.env` for local development. Never commit real values.
# Every variable is validated at startup (src/config/env.schema.ts).

# development | test | production
NODE_ENV=development
PORT=4000
# Set by CI to the Git commit (sha-xxxxxxx); shown by /api/health/live
APP_VERSION=dev

# Local PostgreSQL from infra/compose/docker-compose.dev.yml
DATABASE_URL=postgresql://metamax:metamax_dev@localhost:5432/metamax?schema=public

# Comma-separated browser origins allowed to call the API (empty = none).
# Next.js calls the API server-side, so production normally leaves this empty.
CORS_ORIGINS=http://localhost:3000
# Number of reverse proxies in front of the API (Nginx = 1)
TRUST_PROXY_HOPS=1
REQUEST_BODY_LIMIT=512kb

# fatal | error | warn | log | debug | verbose
LOG_LEVEL=debug
# json | pretty (default: json in production, pretty elsewhere)
LOG_FORMAT=pretty

# API docs at /api/docs (default: on outside production, off in production)
SWAGGER_ENABLED=true
